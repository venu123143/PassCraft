# ─── App ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# SQLite file (relative to prisma/schema.prisma). Use a postgres:// URL if you switch providers.
DATABASE_URL="file:./data/passcraft.db"
# Comma-separated origins allowed by CORS (empty = allow all, handy for local dev).
CORS_ORIGINS=
# Public URL of this API (e.g. https://passcraft-api.onrender.com). Shown as the server in Swagger.
PUBLIC_BASE_URL=

# ─── Wallet ────────────────────────────────────────────────────────────
# Platform used when POST /passes does not specify one. Supported: google
DEFAULT_WALLET_PLATFORM=google

# ─── Google Wallet ─────────────────────────────────────────────────────
# Issuer ID from https://pay.google.com/business/console (Google Wallet API section).
GOOGLE_ISSUER_ID=3388000000000000000
# client_email from the service-account JSON key.
GOOGLE_SERVICE_ACCOUNT_EMAIL=wallet-issuer@your-project.iam.gserviceaccount.com
# private_key from the service-account JSON key. Keep the quotes; "\n" escapes are fine.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
# Suffix of the pass class id (<issuerId>.<suffix>). Bump it (e.g. _v2) after changing the class template.
GOOGLE_CLASS_SUFFIX=passcraft_generic_v1
# Title at the top of the card.
GOOGLE_CARD_TITLE=PassCraft
# Optional HTTPS logo shown on the card (square PNG recommended).
GOOGLE_LOGO_URL=
# Card background colour.
GOOGLE_BACKGROUND_COLOR=#1a73e8
# Optional comma-separated origins embedded in the save JWT (sites that render the Save button).
WALLET_ORIGINS=
